# ── 必填 ──────────────────────────────────────────────
DISCORD_BOT_TOKEN=請填你在 Discord Developer Portal 拿到的 Bot Token
ANTHROPIC_API_KEY=請填 console.anthropic.com 拿到的 API key
# 你自己的 Discord 使用者 ID（開開發者模式 → 右鍵你的頭像 → 複製使用者 ID）
VINCENT_OWNER_ID=000000000000000000

# ── 人格 ──────────────────────────────────────────────
# 預設讀 repo 根目錄的 CLAUDE.md。多個檔案用 : 分隔，會依序串接。
VINCENT_PERSONA_FILES=../CLAUDE.md

# ── 模型 ──────────────────────────────────────────────
VINCENT_MODEL=claude-opus-5
# 思考深度：low / medium / high / xhigh / max。越高越貴，也越細緻。
VINCENT_EFFORT=medium
# 思考本身：adaptive = 讓它自己決定要想多久（預設）
#           off      = 完全不思考。短回覆省不了多少，長對話才看得出差別
VINCENT_THINKING=adaptive
VINCENT_MAX_TOKENS=8000
# 讓他真的看得見你傳的圖片（不是只看到檔名）。圖片會增加輸入成本。
VINCENT_VISION=1
VINCENT_MAX_IMAGES=4
# 伺服器端 refusal fallback（遇到分類器擋下時自動換模型續寫）
VINCENT_FALLBACKS=1

# ── 記憶 ──────────────────────────────────────────────
VINCENT_DB=./data/vincent.db
# 每次帶進模型的最近訊息則數（超過的會被壓成長期摘要）
VINCENT_HISTORY=60

# ── 主動開口 ──────────────────────────────────────────
VINCENT_TZ=Asia/Taipei
VINCENT_INITIATIVE=1
# 時段@機率，逗號分隔。每天為每個時段擲一次骰，中了就在時段內隨機挑一分鐘。
VINCENT_WINDOWS=08:00-10:30@0.55,13:00-15:30@0.35,21:00-23:30@0.75
# 安靜時段，這段時間絕不主動發訊息
VINCENT_QUIET=01:00-08:00
# 一天最多主動幾次
VINCENT_MAX_PER_DAY=3
# 沉默超過這麼多小時就戳一下（0 = 關閉）
VINCENT_IDLE_HOURS=20
# 她最後一則訊息在這幾分鐘內，就跳過這次主動（剛聊完不用再戳）
VINCENT_RECENT_SKIP_MIN=60
